# Turso / libSQL Configuration
TURSO_DATABASE_URL=libsql://your-database-name-organization.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin JWT signing secret (minimum 32 characters for HS256)
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters-for-hs256

# Stand Multimedia Storage (Cloudflare R2 or portable host URL)
MEDIA_STORAGE_DRIVER=r2
MEDIA_PUBLIC_BASE_URL=https://pub-your-bucket-id.r2.dev
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=culturas-vivas-media
